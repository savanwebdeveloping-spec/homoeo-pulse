rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // PDF files stored in /curriculum_pdfs/{year}/{subject}/{file}
    match /curriculum_pdfs/{allPaths=**} {
      // Authenticated students can stream/download
      allow read: if isAuthenticated();

      // Only administrators can upload or delete PDFs
      // Enforce PDF MIME type and max file size of 75MB
      allow write: if isAdmin()
                   && request.resource.contentType == 'application/pdf'
                   && request.resource.size < 75 * 1024 * 1024;
    }

    // Student profile pictures
    match /profile_photos/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
